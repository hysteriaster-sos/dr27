## transforms

transform sprite_entrance:
    on show:
        yzoom 0.25 yanchor 1.0
        easein_bounce 0.75 yzoom 1.0
    on hide:
        easeout 0.3 alpha 0.0 yoffset 40

transform player:
    on show:
        xalign 1.5 alpha 0.0 yalign 0.5
        easein_cubic 0.3 xalign 1.0 alpha 1.0
    on hide:
        easeout 0.3 alpha 0.0

transform happy:
    ypos 1.25 yanchor 1.0
    easein_elastic 1.0 ypos 1.0


# imagebuttons
screen classroom():
    modal True
    imagebutton:
        xpos 1381
        ypos 960
        focus_mask True
        idle Transform("images/04/04_full.png",zoom= 0.3)
        hover Transform("images/04/04_full.png",zoom= 0.3)
        at sprite_entrance
        action Jump("ezra_1")

